# Variables de docker-compose.yml. NO copies este archivo a mano: genera el .env real con
#   python scripts/init_env.py
# que crea secretos aleatorios. Aquí solo se documentan (sin credenciales reales).

# Contraseñas de PostgreSQL: superusuario (solo initdb) y un usuario por servicio.
POSTGRES_PASSWORD=<aleatoria>
APP_MIGRATOR_DB_PASSWORD=<aleatoria>
APP_AUTH_DB_PASSWORD=<aleatoria>
APP_IA_DB_PASSWORD=<aleatoria>
APP_RETRAIN_DB_PASSWORD=<aleatoria>

# Credencial de servicio de retrain_service (client credentials).
# El worker usa el secreto; auth_service solo conoce su SHA-256.
RETRAIN_CLIENT_SECRET=<aleatorio>
RETRAIN_CLIENT_SECRET_SHA256=<sha256 hex del secreto>

# Administrador inicial: se crea al primer arranque si no existe ningún admin.
ADMIN_EMAIL=admin@nutriscore.local
ADMIN_PASSWORD=<aleatoria, mínimo 12 caracteres>

# true: la cookie del refresh token solo viaja por HTTPS o http://localhost (Chrome, Firefox, Edge).
# Usa false solo si tu navegador no acepta cookies Secure en http://localhost.
COOKIE_SECURE=true

FRONTEND_PORT=3000
LOG_LEVEL=INFO
